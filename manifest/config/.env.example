# ============================================================
# zebra-ops 环境变量模板
# 复制为 .env 后填入实际值
# 环境变量优先级高于 config.yaml 中的同名配置
# 使用方式: export $(cat manifest/config/.env | grep -v '^#' | xargs)
# ============================================================

# ---------- LLM 模型密钥（火山方舟）----------
THINK_CHAT_MODEL_API_KEY=ark-xxxxxxxxxxxxxxxxxxxx
QUICK_CHAT_MODEL_API_KEY=ark-xxxxxxxxxxxxxxxxxxxx

# ---------- Embedding 模型密钥（阿里百炼 DashScope）----------
EMBEDDING_MODEL_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# ---------- CLS MCP Server ----------
TRANSPORT=sse
PORT=3000
TENCENTCLOUD_SECRET_ID=AKIDxxxxxxxxxxxxxxxxxxxx
TENCENTCLOUD_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TENCENTCLOUD_REGION=ap-guangzhou

# ---------- Prometheus ----------
PROMETHEUS_URL=http://localhost:9090

# ---------- 文件存储目录 ----------
FILE_DIR=./storage/uploads
